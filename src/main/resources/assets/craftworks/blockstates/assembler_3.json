{
  "multipart": [
    {
      "apply": {
        "model": "craftworks:block/assembler_3"
      }
    },
    {
      "when": {
        "facing": "north|south",
        "fluid_connections": "true"
      },
      "apply": {
        "model": "craftworks:block/fluid_connection"
      }
    },
    {
      "when": {
        "facing": "east|west",
        "fluid_connections": "true"
      },
      "apply": {
        "model": "craftworks:block/fluid_connection",
        "y": 90
      }
    }
  ]
}
