{
  "multipart": [
    {
      "when": {
        "facing": "north"
      },
      "apply": {
        "model": "craftworks:block/assembler_1"
      }
    },
    {
      "when": {
        "facing": "east"
      },
      "apply": {
        "model": "craftworks:block/assembler_1",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south"
      },
      "apply": {
        "model": "craftworks:block/assembler_1",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west"
      },
      "apply": {
        "model": "craftworks:block/assembler_1",
        "y": 270
      }
    },
    {
      "when": {
        "facing": "north|south",
        "fluid_connections": "true"
      },
      "apply": {
        "model": "craftworks:block/assembler_connections"
      }
    },
    {
      "when": {
        "facing": "east|west",
        "fluid_connections": "true"
      },
      "apply": {
        "model": "craftworks:block/assembler_connections",
        "y": 90
      }
    }
  ]
}
