{
  "multipart": [
    {
      "apply": {
        "model": "craftworks:block/oil_refinery"
      }
    },
    {
      "when": {
        "facing": "north",
        "fluid_connections": "true"
      },
      "apply": {
        "model": "craftworks:block/oil_refinery_connections"
      }
    },
    {
      "when": {
        "facing": "east",
        "fluid_connections": "true"
      },
      "apply": {
        "model": "craftworks:block/oil_refinery_connections",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south",
        "fluid_connections": "true"
      },
      "apply": {
        "model": "craftworks:block/oil_refinery_connections",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west",
        "fluid_connections": "true"
      },
      "apply": {
        "model": "craftworks:block/oil_refinery_connections",
        "y": 270
      }
    }
  ]
}
