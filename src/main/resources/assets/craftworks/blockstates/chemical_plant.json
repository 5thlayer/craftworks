{
  "multipart": [
    {
      "apply": {
        "model": "craftworks:block/chemical_plant"
      }
    },
    {
      "when": {
        "facing": "north|south",
        "fluid_connections": "true"
      },
      "apply": {
        "model": "craftworks:block/chemical_plant_connections"
      }
    },
    {
      "when": {
        "facing": "east|west",
        "fluid_connections": "true"
      },
      "apply": {
        "model": "craftworks:block/chemical_plant_connections",
        "y": 90
      }
    }
  ]
}
